      {
        q: '今の結婚に対する気持ちに一番近いものは？',
        a: [
          '自分に合う相手と、できるだけ早く出会いたい',
          '焦らず、心から納得できる相手を見つけたい',
          '結婚したい気持ちはあるけれど、何から始めればよいか不安',
          '結婚に向けて、具体的に行動を始めたい'
        ]
      },
      {
        q: '婚活をサポートしてもらえるなら、どんな支援がうれしい？',
        a: [
          '希望に合う相手探しや条件整理',
          '交際中の悩みや相手との関係づくりの相談',
          '自分の魅力を見つけ、自信を持つためのサポート',
          '活動計画を立て、出会いから交際まで進めるサポート'
        ]
      }
    ];

    // 親御さん向け5問
    const parentQuestions = [
      {
        q: 'お子さまの結婚について、今のお気持ちに近いものは？',
        a: [
          '本人が望むなら、できる限り積極的に応援したい',
          '本人の気持ちを尊重して、温かく見守りたい',
          '年齢や将来のことを考えると、少し心配になる',
          'まずは結婚について話すきっかけを作りたい'
        ]
      },
      {
        q: 'お子さまが結婚について少し話してくれたら、どうしますか？',
        a: [
          '具体的な情報を集めたり、できることを手伝ったりする',
          'まずは本人の話をじっくり聞く',
          '結婚後の生活や相手選びについて、気になることを伝える',
