        ]
      },
      {
        q: 'お子さまの婚活について、特に気になることは？',
        a: [
          '本人に合う相手と出会えるかどうか',
          '本人が本当に結婚したいと思っているかどうか',
          '年齢や将来、婚活で嫌な思いをしないかどうか',
          'どうすれば自然に結婚を意識するきっかけができるか'
        ]
      },
      {
        q: '結婚相談所について相談するとしたら、どんな形が理想ですか？',
        a: [
          '本人と一緒に話を聞き、具体的に検討したい',
          '本人の意思を大切にし、必要になったら相談したい',
          'まずは親だけで情報を聞き、不安を解消したい',
          'まずは気軽な話から始め、本人にも伝えてみたい'
        ]
      },
      {
        q: 'お子さまの結婚に向けて、どのようなサポートができたらよいと思いますか？',
        a: [
          '相手探しや活動を具体的に手伝う',
          '本人が話したいときに相談に乗る',
          '専門家から情報を聞き、心配や疑問を解消する',
          '本人が結婚について考えるきっかけを作る'
        ]
      }
    ];

    const selfResults = {
      A: {
        title: '理想追求タイプ',
        catch: '妥協よりも、納得できる出会いを。',
        description: '結婚相手に求める条件や価値観を大切にし、自分が納得できる相手と出会いたいタイプです。将来をしっかり考えているからこそ、相手選びにも真剣に向き合う傾向があります。',
        advice: '希望条件を大切にしながらも、最初から条件だけで判断しすぎないことがポイント。実際に話してみることで、思いがけない魅力に気づくこともあります。',
        method: 'まずは理想の結婚生活や譲れない条件を整理し、自分に合う相手像を明確にすることから始めてみましょう。'
      },
      B: {
        title: 'じっくり慎重タイプ',
        catch: '大切なのは、心から安心できる関係。',
        description: '相手との信頼関係や安心感を大切にするタイプです。時間をかけて相手を知り、自然な関係を築いていきたいと考える傾向があります。',
        advice: '慎重に考えることは大切ですが、相手を知る前に結論を急がないことも大切です。少しずつ会話を重ねることで、関係が深まることもあります。',
        method: '自分のペースを尊重しながら、交際中の不安や悩みを相談できる環境で活動するのがおすすめです。'
      },
      C: {
        title: '自信・準備タイプ',
        catch: '変わりたい気持ちが、未来への第一歩。',
        description: '結婚したい気持ちはあるものの、何から始めればよいのか分からなかったり、自分に自信が持てなかったりするタイプです。',
        advice: '最初から完璧な状態で婚活を始める必要はありません。自分のよいところや大切にしたいことを少しずつ整理していきましょう。',
        method: '自己分析やプロフィールづくりなど、準備段階から一緒に取り組めるサポートがおすすめです。'
      },
      D: {
        title: '行動派タイプ',
        catch: '出会いのチャンスを、未来につなげよう。',
        description: '新しい出会いや変化に前向きで、結婚に向けて具体的に行動したいタイプです。チャンスを見つけたら、積極的に動ける傾向があります。',
        advice: '出会いの数だけでなく、一人ひとりと向き合う時間も大切にしましょう。自分に合う相手かどうかを見極めることも重要です。',
        method: '目標や活動計画を決め、出会いから交際まで効率よく進められる環境がおすすめです。'
      }
    };

    const parentResults = {
      A: {
        title: '積極的に応援タイプ',
        catch: 'できることから、前向きに応援したい。',
        description: 'お子さまの幸せを願い、結婚に向けてできることを積極的にサポートしたいタイプです。',
        advice: '応援する気持ちは大切ですが、結婚は本人の意思が何より重要です。本人の希望を確認しながら、必要なときに力になれるとよいでしょう。',
        method: 'まずは親御さま自身が婚活の仕組みや相談所のサポート内容を知り、本人に伝えられる情報を集めてみましょう。'
      },
      B: {
        title: '温かく見守るタイプ',
        catch: '本人の気持ちを尊重し、そっと寄り添う。',
        description: 'お子さまの人生や選択を尊重し、本人のタイミングを大切にしたいタイプです。',
        advice: '見守ることに加えて、本人が話したくなったときに安心して相談できる雰囲気を作っておくことも大切です。',
        method: '無理に話を進めず、日常の会話の中で結婚や将来について自然に話せる機会を作ってみましょう。'
      },
      C: {
        title: '心配先回りタイプ',
        catch: '大切だからこそ、将来が気になる。',
        description: 'お子さまの将来や生活を真剣に考えるからこそ、年齢や出会いの機会、婚活でのトラブルなどが気になりやすいタイプです。',
        advice: '心配をそのまま伝えると、本人がプレッシャーに感じることもあります。まずは情報を整理し、本人の気持ちを聞くことから始めてみましょう。',
        method: '親御さまだけで専門家に相談し、婚活の仕組みやサポート内容を知ることから始めるのも一つの方法です。'
      },
      D: {
        title: 'きっかけづくりタイプ',
        catch: '自然な会話から、新しい一歩を。',
        description: 'お子さまに結婚を意識するきっかけを作りたいと考えるタイプです。無理に話を進めるより、自然な形で関心を持ってもらいたい傾向があります。',
        advice: '結婚の話題を切り出すときは、本人の気持ちや状況に配慮することが大切です。何気ない会話から始めてみましょう。',
        method: '親御さまが先に情報を知っておき、本人が関心を持ったときに選択肢を伝えられるようにしておくとよいでしょう。'
      }
    };

    let currentTarget = 'self';
    let currentQuestions = [];
    let currentIndex = 0;
    let answers = [];

    function showScreen(id) {
      ['startScreen', 'quizScreen', 'resultScreen'].forEach(screenId => {
        document.getElementById(screenId).classList.add('hidden');
      });
      document.getElementById(id).classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function startQuiz(target) {
      currentTarget = target;
      currentQuestions = target === 'self' ? selfQuestions : parentQuestions;
      currentIndex = 0;
      answers = [];
      showScreen('quizScreen');
      renderQuestion();
    }

    function renderQuestion() {
      const total = currentQuestions.length;
      const question = currentQuestions[currentIndex];

      document.getElementById('targetLabel').textContent =
        currentTarget === 'self' ? '本人向け診断' : '親御さん向け診断';

      document.getElementById('progressText').textContent =
        `${currentIndex + 1} / ${total}`;

      document.getElementById('progressBar').style.width =
        `${((currentIndex + 1) / total) * 100}%`;

      document.getElementById('questionText').textContent = question.q;

      const choices = document.getElementById('choices');
      choices.innerHTML = '';

      question.a.forEach((answer, index) => {
        const letter = letters[index];
        const button = document.createElement('button');
        button.className = 'choice';
        button.innerHTML =
          `<span class="choice-letter">${letter}</span>${answer}`;

        button.addEventListener('click', () => selectAnswer(letter));
        choices.appendChild(button);
      });

      document.getElementById('backButton').style.visibility =
        currentIndex === 0 ? 'hidden' : 'visible';
    }

    function selectAnswer(letter) {
      answers[currentIndex] = letter;

      if (currentIndex < currentQuestions.length - 1) {
        currentIndex++;
        renderQuestion();
      } else {
        showResult();
      }
    }

    function goBack() {
      if (currentIndex > 0) {
        currentIndex--;
        renderQuestion();
      }
    }

    function calculateResult() {
      const counts = { A: 0, B: 0, C: 0, D: 0 };

      answers.forEach(answer => {
        counts[answer]++;
      });

      const maxCount = Math.max(...Object.values(counts));
      const tiedLetters = letters.filter(letter => counts[letter] === maxCount);

      // 同点の場合、最後の質問からさかのぼって該当タイプを優先
      for (let i = answers.length - 1; i >= 0; i--) {
        if (tiedLetters.includes(answers[i])) {
          return answers[i];
        }
      }

      return 'A';
    }

    function showResult() {
      const resultType = calculateResult();
      const results = currentTarget === 'self' ? selfResults : parentResults;
      const result = results[resultType];

      document.getElementById('resultTitle').textContent = result.title;
      document.getElementById('resultCatchcopy').textContent = result.catch;
      document.getElementById('resultDescription').textContent = result.description;
      document.getElementById('resultAdvice').textContent = result.advice;
      document.getElementById('resultMethod').textContent = result.method;

      const parentNotice = document.getElementById('parentNotice');

      if (currentTarget === 'parent') {
        parentNotice.textContent =
          'この診断は、親御さまご自身の関わり方の傾向を整理するものです。お子さまの結婚への気持ちや意思を判定するものではありません。親御さまだけでのご相談も歓迎しております。';
        parentNotice.classList.remove('hidden');
      } else {
        parentNotice.classList.add('hidden');
      }

      showScreen('resultScreen');
    }

    function openConsultation() {
      if (LINE_URL.includes('ここに公式LINEのURL')) {
        alert('LINE公式アカウントのURLがまだ設定されていません。Code.gsではなく、Index.html内のLINE_URLを設定してください。');
        return;
      }

      window.open(LINE_URL, '_blank');
    }

    function restartQuiz() {
      currentIndex = 0;
      answers = [];
      showScreen('startScreen');
    }
  </script>
</body>
</html>
